<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Akademi Paneli | Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="style.css">
</head>
<body class="bg-dark text-light">

  <nav class="navbar navbar-dark bg-black border-bottom border-secondary px-3">
    <a class="navbar-brand fw-bold text-warning" href="#"><i class="bi bi-mortarboard-fill me-2"></i>AKADEMİ</a>
    <div class="d-flex align-items-center gap-3">
      <span class="badge bg-secondary">Öğrenci Paneli</span>
      <div class="user-avatar bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;">İ</div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="row min-vh-100">
      
      <!-- Sol Panel: Ders Menüsü -->
      <aside class="col-md-4 col-lg-3 bg-black p-3 border-end border-secondary">
        <h6 class="text-uppercase text-secondary small fw-bold mb-3">Eğitim İçeriği</h6>
        
        <div class="progress mb-3 bg-secondary" style="height: 8px;">
          <div class="progress-bar bg-warning" role="progressbar" style="width: 25%;" id="courseProgress"></div>
        </div>
        <p class="small text-secondary mb-4">%25 Tamamlandı</p>

        <div class="list-group list-group-flush" id="lessonList">
          <button class="list-group-item list-group-item-action active bg-secondary text-light border-0 rounded mb-2 d-flex justify-content-between align-items-center" onclick="changeVideo('https://www.youtube.com/embed/dQw4w9WgXcQ', this)">
            <span><i class="bi bi-play-circle me-2"></i>1. Derse Giriş</span>
            <i class="bi bi-check-circle-fill text-warning"></i>
          </button>
          <button class="list-group-item list-group-item-action bg-dark text-light border-0 rounded mb-2 d-flex justify-content-between align-items-center" onclick="changeVideo('https://www.youtube.com/embed/dQw4w9WgXcQ', this)">
            <span><i class="bi bi-play-circle me-2"></i>2. Temel Kavramlar</span>
            <i class="bi bi-circle text-secondary"></i>
          </button>
          <button class="list-group-item list-group-item-action bg-dark text-light border-0 rounded mb-2 d-flex justify-content-between align-items-center" onclick="changeVideo('https://www.youtube.com/embed/dQw4w9WgXcQ', this)">
            <span><i class="bi bi-play-circle me-2"></i>3. Uygulama ve Test</span>
            <i class="bi bi-circle text-secondary"></i>
          </button>
        </div>
      </aside>

      <!-- Sağ Panel: Video ve İçerik Alanı -->
      <main class="col-md-8 col-lg-9 p-4">
        <div class="ratio ratio-16x9 mb-4 rounded overflow-hidden shadow border border-secondary">
          <iframe id="videoPlayer" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="Ders Videosu" allowfullscreen></iframe>
        </div>

        <div class="card bg-black border-secondary p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 id="lessonTitle" class="text-warning mb-1">1. Derse Giriş</h4>
              <p class="text-secondary small mb-0">Bu derste temel prensipler ve sistem tanıtımı yapılmaktadır.</p>
            </div>
            <button class="btn btn-warning fw-semibold px-4" onclick="toggleComplete()"><i class="bi bi-check2 me-1"></i>Tamamlandı İşaretle</button>
          </div>
        </div>
      </main>

    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
